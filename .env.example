# Copie este arquivo para .env e preencha os valores

# Porta
PORT=5000

# Chave secreta JWT — OBRIGATÓRIA, mínimo 24 caracteres. Sem ela o servidor não sobe (não existe
# mais fallback no server.js: o antigo era público e valia como segredo de verdade quando a
# variável faltava). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Em produção (EC2), guarde no Secrets Manager e injete como env var.
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-aqui-com-mais-de-24-caracteres

# Origens extras liberadas no CORS, separadas por vírgula. A própria origem (o front é servido
# por este servidor) já é aceita; só preencha se outro site precisar chamar a API.
ALLOWED_ORIGINS=

# String de conexão do Postgres (Aurora PostgreSQL Serverless v2 em produção).
# Local: postgres://localhost/nome_do_banco — sem senha, se o Postgres local não exigir.
# Produção: postgres://usuario:senha@endpoint-do-aurora:5432/nome_do_banco
DATABASE_URL=postgres://localhost/reidascarnes

# Chaves VAPID (push notifications) — em dev, o server.js gera automaticamente na primeira
# subida se estas variáveis não estiverem definidas. Em produção (múltiplas instâncias EC2),
# gere uma vez com `node -e "console.log(require('web-push').generateVAPIDKeys())"`, salve no
# Secrets Manager e sempre injete as duas — senão cada instância gera um par diferente e
# quebra as assinaturas de push já registradas pelos navegadores.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# S3 (fotos de perfil e portfólio). Sem S3_BUCKET_NAME definido, o server.js mantém o
# comportamento antigo (foto salva como base64 direto no banco) — útil em dev local.
S3_BUCKET_NAME=
AWS_REGION=us-east-1

# Focus NFe (emissão de NF-e do módulo açougue — ver focus-nfe.js). Sem FOCUS_NFE_TOKEN, as
# notas emitidas em /acougue/notas ficam salvas localmente como rascunho, sem nenhuma
# transmissão à SEFAZ. Para emitir de verdade:
#   1. Contrate a Focus NFe (https://focusnfe.com.br) — não é gratuito em produção.
#   2. Tenha CNPJ + Inscrição Estadual do açougue e certificado digital (A1/A3) cadastrados lá.
#   3. Cole o token de homologação/produção abaixo e preencha CNPJ/IE em
#      Configurações dentro do próprio sistema (aba do usuário reidascarnes).
FOCUS_NFE_TOKEN=
# Quanto o caixa espera a Focus responder, em milissegundos. O fetch do Node não tem prazo
# próprio (padrão do undici: 300s), e sem isto uma SEFAZ pendurada congelava a venda por
# CINCO MINUTOS com a fila esperando. Estourando o prazo a venda fica gravada, sai o
# comprovante sem valor fiscal, e a nota se emite depois pelo histórico.
FOCUS_TIMEOUT_MS=15000
FOCUS_TIMEOUT_ARQUIVO_MS=10000

# homologacao = ambiente de testes (não emite nota válida) | producao = nota fiscal real
FOCUS_NFE_ENV=homologacao
