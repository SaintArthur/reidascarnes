{
  "name": "reidascarnes-sistema",
  "version": "2.1.0",
  "description": "Sistema de gestão para açougue: balança, caixa, NFC-e, estoque e rendimento de carcaça",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node deploy/checar-isolamento.js && jest --runInBand",
    "test:isolamento": "node deploy/checar-isolamento.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "acougue",
    "pdv",
    "nfce",
    "balanca",
    "estoque",
    "carcaca"
  ],
  "author": "Rei das Carnes",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/rds-signer": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "forceExit": true
  }
}
